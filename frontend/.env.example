# Frontend environment variables (Vite)
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NOTE: In Docker (docker compose up), the frontend talks to the backend
# through the nginx proxy (/api/* → backend:3001) so this variable is only
# needed when running the Vite dev server directly on the host.

VITE_API_URL=http://localhost:3001
